        "url": "={{ $json.url }}/message/sendText/{{ encodeURIComponent($json.instancia) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.number, text: $json.text }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "notes": "Credencial Header Auth «Evolution API R4»: Name = apikey · Value = apikey de la instancia"
    },
